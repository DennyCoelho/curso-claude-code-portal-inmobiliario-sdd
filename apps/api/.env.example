# Copie este arquivo para apps/api/.env.local a partir da raiz do repositório.
# O PostgreSQL é necessário para os comandos de banco da Etapa 3 em diante.

# PostgreSQL: use a senha do seu contêiner e codifique caracteres especiais na URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/portal_inmobiliario"

# Autenticação: origens exatas permitidas nos POSTs, separadas por vírgula.
# Em produção, configure a URL HTTPS pública do frontend e, se usado, do backend.
# Sessões opacas no PostgreSQL não exigem AUTH_SECRET.
AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Recuperação de senha: origem pública do frontend e e-mail remetente verificado no Resend.
# Em produção, WEB_URL exige HTTPS. Use somente o endereço, sem nome em AUTH_EMAIL_FROM.
# Sem esses valores, a solicitação retorna 503 para todas as contas.
WEB_URL="http://localhost:3000"
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""

# Cloudinary: credenciais do servidor para gerenciar imagens.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Reservada para futuras APIs do Google Maps no servidor.
# A incorporação pública da Etapa 15 não utiliza esta chave; zoom em apps/web.
GOOGLE_MAPS_API_KEY=""

# Web3Forms: access key pública do formulário, entregue ao navegador após validação.
# O plano gratuito envia diretamente do navegador ao provedor.
# Sem chave, POST /api/contact retorna 503; nunca use uma chave fictícia.
WEB3FORMS_ACCESS_KEY=""

# Não utilize NEXT_PUBLIC_ para segredos: esse prefixo expõe valores ao navegador.
