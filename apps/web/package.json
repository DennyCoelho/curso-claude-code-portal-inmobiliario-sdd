{
  "name": "@portal-inmobiliario/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:check": "tsx scripts/check-database.ts",
    "db:test": "tsx --test scripts/domain-model.test.ts scripts/seed.integration.test.ts",
    "seed:test": "tsx --test scripts/seed.test.ts",
    "api:test": "node --conditions=react-server --import tsx --test scripts/public-property.test.ts",
    "api:test:integration": "node --conditions=react-server --import tsx --test scripts/public-property.integration.test.ts",
    "home:test": "tsx --test scripts/home.test.tsx",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
