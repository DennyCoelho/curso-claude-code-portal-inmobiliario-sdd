generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PropertyOperation {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  OFFICE
  COMMERCIAL
  OTHER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique @db.VarChar(254)
  passwordHash String
  role         UserRole   @default(USER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  favorites    Favorite[]
  inquiries    Inquiry[]
}

model Property {
  id                String            @id @default(uuid()) @db.Uuid
  title             String
  description       String
  operation         PropertyOperation
  type              PropertyType
  // Valor total de venda ou mensal de aluguel, sempre em BRL.
  price             Decimal           @db.Decimal(14, 2)
  usableArea        Decimal?          @db.Decimal(12, 2)
  totalArea         Decimal?          @db.Decimal(12, 2)
  bedrooms          Int?
  bathrooms         Int?
  parkingSpaces     Int?
  age               Int?
  address           String
  addressNumber     String
  addressComplement String?
  neighborhood      String
  city              String
  state             String            @db.VarChar(2)
  postalCode        String            @db.VarChar(8)
  country           String            @default("BR") @db.VarChar(2)
  isPublished       Boolean           @default(false)
  isFeatured        Boolean           @default(false)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  images            PropertyImage[]
  features          Feature[]
  favorites         Favorite[]
  inquiries         Inquiry[]

  // Listagens públicas por data, operação/tipo, localização e preço.
  @@index([isPublished, createdAt(sort: Desc)])
  @@index([isPublished, operation, type])
  @@index([state, city, neighborhood])
  @@index([isPublished, price])
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  url        String
  publicId   String   @unique
  position   Int      @default(0)
  // A migração SQL limita a uma imagem principal por imóvel.
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
}

model Feature {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  properties Property[]
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model Inquiry {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  userId     String?  @db.Uuid
  name       String
  email      String   @db.VarChar(254)
  phone      String   @db.VarChar(14)
  message    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([propertyId, createdAt(sort: Desc)])
}
