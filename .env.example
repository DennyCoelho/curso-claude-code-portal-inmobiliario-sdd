# Copiar este archivo a apps/web/.env.local desde la raíz del repositorio.
# El arranque del Paso 1 no requiere credenciales ni servicios externos.

# PostgreSQL (se configurará en el Paso 3).
DATABASE_URL="postgresql://postgres:password@localhost:5432/portal_inmobiliario?schema=public"

# Autenticación: generar un secreto al implementar las sesiones.
AUTH_SECRET=""

# Cloudinary: credenciales de servidor para administrar imágenes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps: configuración de servidor para la integración del mapa.
GOOGLE_MAPS_API_KEY=""

# Web3Forms: clave de servidor para el envío de consultas.
WEB3FORMS_ACCESS_KEY=""

# No utilizar NEXT_PUBLIC_ para secretos: ese prefijo expone valores al navegador.
