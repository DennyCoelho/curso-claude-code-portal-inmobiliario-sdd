# Copie este arquivo para apps/web/.env.local a partir da raiz do repositório.
# A inicialização da Etapa 1 não exige credenciais nem serviços externos.

# PostgreSQL (será configurado na Etapa 3).
DATABASE_URL="postgresql://postgres:password@localhost:5432/portal_inmobiliario?schema=public"

# Autenticação: gere um segredo ao implementar as sessões.
AUTH_SECRET=""

# Cloudinary: credenciais do servidor para gerenciar imagens.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps: configuração do servidor para a integração do mapa.
GOOGLE_MAPS_API_KEY=""

# Web3Forms: chave do servidor para o envio de consultas.
WEB3FORMS_ACCESS_KEY=""

# Não utilize NEXT_PUBLIC_ para segredos: esse prefixo expõe valores ao navegador.
